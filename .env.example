# Sao chép thành .env hoặc đặt các biến này trong môi trường (KHÔNG commit file .env thật).
# Mặc định dự án chạy hoàn toàn bằng luật, không cần biến nào dưới đây.

# --- Engine LLM tùy chọn (tắt mặc định) ---
# CV_AGENT_ENABLE_LLM=1
# ANTHROPIC_API_KEY=your-api-key-here
# CV_AGENT_MODEL=claude-sonnet-5-5

# --- Tùy chọn khác ---
# CV_AGENT_OUTPUT_DIR=./outputs     # thư mục lưu kết quả
# CV_AGENT_AS_OF=2026-01            # cố định mốc "hiện tại" để kết quả tái lập được
# CV_AGENT_LEXICON=./lexicon_user.json
